execute_process(COMMAND "${DEMO}" "${OUTPUT_DIR}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "visual report demo failed: ${error}")
endif()
set(success "${OUTPUT_DIR}/stage2-solved.html")
set(failure "${OUTPUT_DIR}/stage1-mapping-conflict.html")
set(nested "${OUTPUT_DIR}/stage2-nested-pairs.html")
set(single_pair "${OUTPUT_DIR}/stage2-single-mapped-pair.html")
set(two_parents "${OUTPUT_DIR}/stage2-two-parent-pairs.html")
set(roots_0_0 "${OUTPUT_DIR}/stage2-roots-0-0.html")
set(roots_0_1 "${OUTPUT_DIR}/stage2-roots-0-1.html")
set(roots_1_0 "${OUTPUT_DIR}/stage2-roots-1-0.html")
set(roots_0_n "${OUTPUT_DIR}/stage2-roots-0-n.html")
set(roots_n_0 "${OUTPUT_DIR}/stage2-roots-n-0.html")
set(roots_1_1 "${OUTPUT_DIR}/stage2-roots-1-1-one-to-one.html")
set(roots_1_n "${OUTPUT_DIR}/stage2-roots-1-n-one-to-many.html")
set(roots_n_1 "${OUTPUT_DIR}/stage2-roots-n-1-many-to-one.html")
set(roots_n_n "${OUTPUT_DIR}/stage2-roots-n-n-mixed.html")
set(matrix_index "${OUTPUT_DIR}/stage2-case-matrix-index.html")
foreach(file IN ITEMS "${success}" "${failure}" "${nested}" "${single_pair}" "${two_parents}"
    "${roots_0_0}" "${roots_0_1}" "${roots_1_0}" "${roots_0_n}" "${roots_n_0}"
    "${roots_1_1}" "${roots_1_n}" "${roots_n_1}" "${roots_n_n}" "${matrix_index}")
  if(NOT EXISTS "${file}")
    message(FATAL_ERROR "missing report: ${file}")
  endif()
endforeach()
file(READ "${success}" solved)
file(READ "${failure}" failed)
file(READ "${nested}" nested_html)
file(READ "${single_pair}" single_pair_html)
file(READ "${two_parents}" two_parents_html)
file(READ "${roots_0_0}" roots_0_0_html)
file(READ "${roots_0_1}" roots_0_1_html)
file(READ "${roots_1_0}" roots_1_0_html)
file(READ "${roots_0_n}" roots_0_n_html)
file(READ "${roots_n_0}" roots_n_0_html)
file(READ "${roots_1_1}" roots_1_1_html)
file(READ "${roots_1_n}" roots_1_n_html)
file(READ "${roots_n_1}" roots_n_1_html)
file(READ "${roots_n_n}" roots_n_n_html)
file(READ "${matrix_index}" matrix_index_html)
foreach(empty_side_html IN ITEMS "${roots_0_0_html}" "${roots_0_1_html}" "${roots_1_0_html}"
    "${roots_0_n_html}" "${roots_n_0_html}")
  string(FIND "${empty_side_html}" "排布成功" index)
  if(index EQUAL -1)
    message(FATAL_ERROR "empty-side matrix report is not solved")
  endif()
  string(REGEX MATCHALL "class=\"map-row\"" empty_relations "${empty_side_html}")
  list(LENGTH empty_relations relation_count)
  if(NOT relation_count EQUAL 0)
    message(FATAL_ERROR "empty-side matrix report must not contain relations")
  endif()
  string(FIND "${empty_side_html}" "普通对应" index)
  if(NOT index EQUAL -1)
    message(FATAL_ERROR "new matrix report contains an ordinary relation")
  endif()
endforeach()
foreach(expected IN ITEMS "zero-negative-root" "zero-positive-root")
  string(FIND "${roots_0_1_html}${roots_1_0_html}" "${expected}" index)
  if(index EQUAL -1)
    message(FATAL_ERROR "single-root matrix reports missing: ${expected}")
  endif()
endforeach()
foreach(expected IN ITEMS "negative-root-a" "negative-root-b")
  string(FIND "${roots_0_n_html}" "${expected}" index)
  if(index EQUAL -1)
    message(FATAL_ERROR "0 x N report missing: ${expected}")
  endif()
endforeach()
foreach(expected IN ITEMS "positive-root-a" "positive-root-b")
  string(FIND "${roots_n_0_html}" "${expected}" index)
  if(index EQUAL -1)
    message(FATAL_ERROR "N x 0 report missing: ${expected}")
  endif()
endforeach()
foreach(expected IN ITEMS "one-positive-root" "positive-nested-child" "one-negative-root"
    "negative-nested-child" "同位置" "排布成功")
  string(FIND "${roots_1_1_html}" "${expected}" index)
  if(index EQUAL -1)
    message(FATAL_ERROR "1 x 1 report missing: ${expected}")
  endif()
endforeach()
string(REGEX MATCHALL "class=\"map-row\"" roots_1_1_relations "${roots_1_1_html}")
list(LENGTH roots_1_1_relations relation_count)
if(NOT relation_count EQUAL 1)
  message(FATAL_ERROR "1 x 1 report must contain exactly one relation")
endif()
string(FIND "${roots_1_1_html}" "普通对应" index)
if(NOT index EQUAL -1)
  message(FATAL_ERROR "1 x 1 report contains an ordinary relation")
endif()
foreach(repeated_case_html IN ITEMS "${roots_1_n_html}" "${roots_n_1_html}")
  string(FIND "${repeated_case_html}" "排布成功" index)
  if(index EQUAL -1)
    message(FATAL_ERROR "repeated-endpoint matrix report is not solved")
  endif()
  string(REGEX MATCHALL "class=\"map-row\"" repeated_relations "${repeated_case_html}")
  list(LENGTH repeated_relations relation_count)
  if(NOT relation_count EQUAL 2)
    message(FATAL_ERROR "repeated-endpoint matrix report must contain exactly two relations")
  endif()
  string(REGEX MATCHALL "style=\"--depth:0\"" top_level_nodes "${repeated_case_html}")
  list(LENGTH top_level_nodes top_level_count)
  if(NOT top_level_count EQUAL 3)
    message(FATAL_ERROR "1 x N or N x 1 report must contain three total top-level nodes")
  endif()
  string(FIND "${repeated_case_html}" "普通对应" index)
  if(NOT index EQUAL -1)
    message(FATAL_ERROR "repeated-endpoint matrix report contains an ordinary relation")
  endif()
endforeach()
string(REGEX MATCHALL "data-positive=\"p0\"" one_to_many_repeated "${roots_1_n_html}")
list(LENGTH one_to_many_repeated repeated_count)
if(NOT repeated_count EQUAL 2)
  message(FATAL_ERROR "1 x N report must repeat one positive endpoint")
endif()
string(REGEX MATCHALL "data-negative=\"n0\"" many_to_one_repeated "${roots_n_1_html}")
list(LENGTH many_to_one_repeated repeated_count)
if(NOT repeated_count EQUAL 2)
  message(FATAL_ERROR "N x 1 report must repeat one negative endpoint")
endif()
foreach(expected IN ITEMS "排布成功" "mix-p-one" "mix-n-one" "mix-p-otm"
    "mix-n-otm-parent" "mix-n-otm-child" "mix-p-mto-parent" "mix-p-mto-child"
    "mix-n-mto" "class=\"section-circle\"")
  string(FIND "${roots_n_n_html}" "${expected}" index)
  if(index EQUAL -1)
    message(FATAL_ERROR "N x N mixed report missing: ${expected}")
  endif()
endforeach()
string(REGEX MATCHALL "class=\"map-row\"" mixed_relations "${roots_n_n_html}")
list(LENGTH mixed_relations relation_count)
if(NOT relation_count EQUAL 5)
  message(FATAL_ERROR "N x N mixed report must contain exactly five relations")
endif()
string(REGEX MATCHALL "style=\"--depth:0\"" mixed_top_level_nodes "${roots_n_n_html}")
list(LENGTH mixed_top_level_nodes top_level_count)
if(NOT top_level_count EQUAL 6)
  message(FATAL_ERROR "N x N mixed report must contain three top-level nodes per side")
endif()
string(REGEX MATCHALL "data-positive=\"p3\"" mixed_one_to_many "${roots_n_n_html}")
list(LENGTH mixed_one_to_many repeated_count)
if(NOT repeated_count EQUAL 2)
  message(FATAL_ERROR "N x N mixed report must contain its one-to-many group")
endif()
string(REGEX MATCHALL "data-negative=\"n4\"" mixed_many_to_one "${roots_n_n_html}")
list(LENGTH mixed_many_to_one repeated_count)
if(NOT repeated_count EQUAL 2)
  message(FATAL_ERROR "N x N mixed report must contain its many-to-one group")
endif()
string(FIND "${roots_n_n_html}" "data-positive=\"p0\" data-negative=\"n0\"" index)
if(index EQUAL -1)
  message(FATAL_ERROR "N x N mixed report must contain its one-to-one group")
endif()
string(FIND "${roots_n_n_html}" "普通对应" index)
if(NOT index EQUAL -1)
  message(FATAL_ERROR "N x N mixed report contains an ordinary relation")
endif()
foreach(expected IN ITEMS "0/1/N × 0/1/N" "一对一" "一对多" "多对一" "混合"
    "stage2-roots-0-0.html" "stage2-roots-0-1.html" "stage2-roots-1-0.html"
    "stage2-roots-0-n.html" "stage2-roots-n-0.html"
    "stage2-roots-1-1-one-to-one.html" "stage2-roots-1-n-one-to-many.html"
    "stage2-roots-n-1-many-to-one.html" "stage2-roots-n-n-mixed.html")
  string(FIND "${matrix_index_html}" "${expected}" index)
  if(index EQUAL -1)
    message(FATAL_ERROR "case matrix index missing: ${expected}")
  endif()
endforeach()
foreach(text IN ITEMS "排布成功" "正侧层级" "负侧层级" "同位置" "普通对应"
    "class=\"section-circle\"" "class=\"side-root\""
    "data-node=\"p4\"" "data-node=\"n2\"" "})();</script>")
  string(FIND "${solved}" "${text}" index)
  if(index EQUAL -1)
    message(FATAL_ERROR "success report missing: ${text}")
  endif()
endforeach()
foreach(text IN ITEMS "排布成功" "p0" "p1" "p2" "n0" "n1" "n2"
    "同位置" "class=\"section-circle\"")
  string(FIND "${single_pair_html}" "${text}" index)
  if(index EQUAL -1)
    message(FATAL_ERROR "single mapped pair report missing: ${text}")
  endif()
endforeach()
string(REGEX MATCHALL "class=\"map-row\"" single_relations "${single_pair_html}")
list(LENGTH single_relations relation_count)
if(NOT relation_count EQUAL 1)
  message(FATAL_ERROR "single mapped pair report must contain exactly one relation")
endif()
foreach(text IN ITEMS "排布成功" "p0" "p1" "p2" "p3" "p4"
    "n0" "n1" "n2" "n3" "n4" "同位置")
  string(FIND "${two_parents_html}" "${text}" index)
  if(index EQUAL -1)
    message(FATAL_ERROR "two-parent report missing: ${text}")
  endif()
endforeach()
string(REGEX MATCHALL "class=\"map-row\"" two_parent_relations "${two_parents_html}")
list(LENGTH two_parent_relations relation_count)
if(NOT relation_count EQUAL 3)
  message(FATAL_ERROR "two-parent report must contain exactly three relations")
endif()
foreach(text IN ITEMS "排布失败" "SamePositionConstraintConflict" "SamePositionIncompatible"
    "正侧层级" "负侧层级" "同位置")
  string(FIND "${failed}" "${text}" index)
  if(index EQUAL -1)
    message(FATAL_ERROR "failure report missing: ${text}")
  endif()
endforeach()
string(FIND "${failed}" "class=\"section-circle\"" index)
if(NOT index EQUAL -1)
  message(FATAL_ERROR "failure report contains solved geometry")
endif()
foreach(text IN ITEMS "排布成功" "p0" "p1" "p2" "n0" "n1" "n2"
    "同位置" "class=\"section-circle\"")
  string(FIND "${nested_html}" "${text}" index)
  if(index EQUAL -1)
    message(FATAL_ERROR "nested pairs report missing: ${text}")
  endif()
endforeach()
