set(HRN_PRODUCT_SOURCE_ROOT "" CACHE PATH "Product source root")
set(HRN_PRODUCT_POINT_TYPE "" CACHE STRING "Product Point adapter type")
set(HRN_PRODUCT_MATRIX_TYPE "" CACHE STRING "Product Matrix adapter type")
set(HRN_PRODUCT_SEGMENT_TYPE "" CACHE STRING "Product Segment adapter type")
set(HRN_PRODUCT_BASELINE_COMMIT "" CACHE STRING "Product baseline commit")
if(HRN_ENABLE_PRODUCT_ADAPTER)
  if(NOT IS_DIRECTORY "${HRN_PRODUCT_SOURCE_ROOT}")
    message(FATAL_ERROR "HRN_PRODUCT_SOURCE_ROOT must be an existing product checkout")
  endif()
  foreach(name HrnCrossSectLayout.cpp HrnPosPntCrt.cpp HarnessAlg.cpp)
    file(GLOB_RECURSE matches "${HRN_PRODUCT_SOURCE_ROOT}/${name}")
    if(NOT matches)
      message(FATAL_ERROR "Missing product source: ${name}")
    endif()
  endforeach()
  foreach(value HRN_PRODUCT_POINT_TYPE HRN_PRODUCT_MATRIX_TYPE HRN_PRODUCT_SEGMENT_TYPE HRN_PRODUCT_BASELINE_COMMIT)
    if(NOT ${value})
      message(FATAL_ERROR "Missing product integration value: ${value}")
    endif()
  endforeach()
endif()
